Write-Host "  Get-Content -LiteralPath `"$ReportPath`" -Raw"
Write-Host ""
Write-Host "Mesu trusted survivors:"
Write-Host "  $MesuTrustedCsv"
Write-Host ""
Write-Host "Controls trusted survivors:"
Write-Host "  $ControlsTrustedCsv"
Write-Host ""
Write-Host "Preview:"
Write-Host ""

Get-Content -LiteralPath $ReportPath -Raw
.z)
                    } catch {
                        0.0
                    }
                }
                Descending = $true
            } |
            Select-Object -First 1

        $strongestAbsZ = 0.0
        if ($null -ne $strongest -and $null -ne $strongest.z -and "$($strongest.z)" -ne "") {
            try {
                $strongestAbsZ = [math]::Abs([double]$strongest.z)
            } catch {
                $strongestAbsZ = 0.0
            }
        }

        $strongestEvent = ""
        $strongestMetric = ""

        if ($null -ne $strongest) {
            $strongestEvent = [string]$strongest.event
            $strongestMetric = [string]$strongest.metric
        }

        [pscustomobject]@{
            input = $group.Name
            trusted_survivor_count = $groupRows.Count
            strongest_abs_z = $strongestAbsZ
            strongest_event = $strongestEvent
            strongest_metric = $strongestMetric
        }
    }

    $summaryRows |
        Sort-Object -Property trusted_survivor_count,strongest_abs_z -Descending |
        Export-Csv -LiteralPath $OutCsv -NoTypeInformation -Encoding UTF8
}
function Convert-RowsToMarkdown {
    param(
        [Parameter(Mandatory=$true)][object[]]$Rows,
        [Parameter(Mandatory=$true)][string[]]$Columns,
        [int]$MaxRows = 20
    )

    if ($Rows.Count -eq 0) {
        return "_No trusted survivors after filtering._"
    }

    $limited = @($Rows | Select-Object -First $MaxRows)

    $header = "| " + ($Columns -join " | ") + " |"
    $divider = "| " + (($Columns | ForEach-Object { "---" }) -join " | ") + " |"
    $lines = New-Object System.Collections.Generic.List[string]
    $lines.Add($header)
    $lines.Add($divider)

    foreach ($row in $limited) {
        $cells = foreach ($col in $Columns) {
            $value = [string]$row.$col
            $value = $value.Replace("|", "\|")
            if ($value.Length -gt 120) {
                $value = $value.Substring(0, 117) + "..."
            }
            $value
        }

        $lines.Add("| " + ($cells -join " | ") + " |")
    }

    return ($lines -join [Environment]::NewLine)
}

