$report.Add("")
$report.Add("## Controls top trusted survivors")
$report.Add("")
$report.Add((Convert-RowsToMarkdown -Rows $ControlsTrusted -Columns @("language_guess", "encoding", "event", "metric", "z", "p_emp", "input") -MaxRows 30))
$report.Add("")
$report.Add("## Generated files")
