    Copy-Item -Force -LiteralPath $CanonicalNoPuncCsv -Destination (Join-Path $PaperOut "canonical_udhr_no_punctuation_final_comparison_table.csv")
    $CanonicalMesuNoPunc = @(Import-Csv -LiteralPath $CanonicalNoPuncCsv | Where-Object { $_.language_guess -eq "mesu" }) | Select-Object -First 1
