function Assert-File {
    param(
        [Parameter(Mandatory=$true)][string]$Path,
        [Parameter(Mandatory=$true)][string]$Purpose
    )

    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {
        throw "Missing $Purpose at: $Path"
    }
}

function Assert-Dir {
    param(
        [Parameter(Mandatory=$true)][string]$Path,
        [Parameter(Mandatory=$true)][string]$Purpose
    )

    if (-not (Test-Path -LiteralPath $Path -PathType Container)) {
        throw "Missing $Purpose at: $Path"
    }
}

function Invoke-Native {
    param(
        [Parameter(Mandatory=$true)][string]$Name,
        [Parameter(Mandatory=$true)][string]$FilePath,
        [Parameter(Mandatory=$true)][string[]]$Arguments
    )

    Write-Host ""
    Write-Host "=== $Name ===" -ForegroundColor Cyan
    Write-Host "> $FilePath $($Arguments -join ' ')" -ForegroundColor DarkGray

    & $FilePath @Arguments

    if ($LASTEXITCODE -ne 0) {
        throw "$Name failed with exit code $LASTEXITCODE"
    }
}

function Get-PythonCommand {
    & py -3 --version *> $null
    if ($LASTEXITCODE -eq 0) {
        return @{
            Cmd = "py"
            Prefix = @("-3")
        }
    }

    & python --version *> $null
    if ($LASTEXITCODE -eq 0) {
        return @{
            Cmd = "python"
            Prefix = @()
        }
    }

    throw "Could not find Python via 'py -3' or 'python'."
}

function New-DeterministicControlFiles {
    param(
        [Parameter(Mandatory=$true)][string]$SourceMesuUdhr,
        [Parameter(Mandatory=$true)][string]$OutDir
    )

    New-Item -Force -ItemType Directory -Path $OutDir | Out-Null

    $mesu = Get-Content -LiteralPath $SourceMesuUdhr -Raw -Encoding UTF8

    $duplicated = @(
        $mesu.Trim()
        ""
        $mesu.Trim()
        ""
        $mesu.Trim()
        ""
        $mesu.Trim()
    ) -join [Environment]::NewLine

    Set-Content -LiteralPath (Join-Path $OutDir "control_mesu_udhr_duplicated_x4.txt") `
        -Value $duplicated `
        -Encoding UTF8

    $punctuation = @(".", ",", ";", ":", "!", "?")
    $sb = New-Object System.Text.StringBuilder
    $nonWhitespaceCount = 0
    $punctuationIndex = 0

    foreach ($ch in $mesu.ToCharArray()) {
        [void]$sb.Append($ch)

        if (-not [char]::IsWhiteSpace($ch)) {
            $nonWhitespaceCount += 1

            if (($nonWhitespaceCount % 5) -eq 0) {
                [void]$sb.Append($punctuation[$punctuationIndex % $punctuation.Count])
                [void]$sb.Append(" ")
                $punctuationIndex += 1
            }
        }
    }

    Set-Content -LiteralPath (Join-Path $OutDir "control_mesu_udhr_punctuation_noise_every5.txt") `
        -Value $sb.ToString() `
        -Encoding UTF8

    $rng = [System.Random]::new(1337)
    $bits = New-Object System.Text.StringBuilder

    for ($i = 0; $i -lt 12000; $i++) {
        [void]$bits.Append($rng.Next(0, 2))
        if ((($i + 1) % 80) -eq 0) {
            [void]$bits.Append([Environment]::NewLine)
        }
    }

    Set-Content -LiteralPath (Join-Path $OutDir "control_random_bits_seed1337_len12000.txt") `
        -Value $bits.ToString() `
        -Encoding UTF8
}

function Get-TrustedSurvivors {
    param(
        [Parameter(Mandatory=$true)][string]$CsvPath
    )

    if (-not (Test-Path -LiteralPath $CsvPath -PathType Leaf)) {
        return @()
    }

    $rows = @(Import-Csv -LiteralPath $CsvPath)

    $trusted = @(
        $rows |
            Where-Object {
                $_.encoding -ne "utf8_bits" -and
                $_.event -notin @("other", "digit", "whitespace") -and
                $_.metric -ne "zeta_spectral_coherence"
            } |
            Sort-Object -Property @{
                Expression = {
                    try {
                        [math]::Abs([double]$_.z)
                    } catch {
                        0.0
                    }
                }
                Descending = $true
            }
    )

    return $trusted
}

function Export-TrustedSurvivors {
    param(
        [Parameter(Mandatory=$true)][object[]]$Rows,
        [Parameter(Mandatory=$true)][string]$OutCsv
    )

    $columns = @("language_guess", "encoding", "event", "metric", "z", "p_emp", "input")

    if ($Rows.Count -eq 0) {
        Set-Content -LiteralPath $OutCsv -Encoding UTF8 -Value (($columns -join ","))
        return
    }

    $Rows |
        Select-Object language_guess, encoding, event, metric, z, p_emp, input |
        Export-Csv -LiteralPath $OutCsv -NoTypeInformation -Encoding UTF8
}

