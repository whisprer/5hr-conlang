Copy-Item -Force -LiteralPath $BashoMesuSource -Destination (Join-Path $MesuRegisterRoot "mesu_basho_text_only.txt")

New-DeterministicControlFiles -SourceMesuUdhr $MesuUdhrSource -OutDir $ControlsRoot

Invoke-Native `
    -Name "Mesu register batch" `
    -FilePath $RrlangExe `
    -Arguments @(
        "batch",
        "--dataset-root", $MesuRegisterRoot,
        "--out-dir", $MesuOut,
        "--language", "MesuRegister",
        "--linguistic-profile",
        "--nulls", "100",
        "--skip-existing"
    )

Invoke-Native `
    -Name "Summarise Mesu register batch" `
    -FilePath $Python.Cmd `
    -Arguments @(
        @($Python.Prefix) +
        @(
            $Summariser,
            "--input", $MesuOut,
            "--out", $MesuSummary
        )
    )

Invoke-Native `
    -Name "Paper-minimum controls batch" `
    -FilePath $RrlangExe `
    -Arguments @(
        "batch",
        "--dataset-root", $ControlsRoot,
        "--out-dir", $ControlsOut,
        "--language", "PaperMinimumControls",
        "--linguistic-profile",
        "--nulls", "100",
        "--skip-existing"
    )

Invoke-Native `
    -Name "Summarise paper-minimum controls batch" `
    -FilePath $Python.Cmd `
    -Arguments @(
        @($Python.Prefix) +
        @(
            $Summariser,
            "--input", $ControlsOut,
            "--out", $ControlsSummary
        )
    )

