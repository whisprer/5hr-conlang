function Get-TrustedSurvivors {
    param(
        [Parameter(Mandatory=$true)][string]$CsvPath
    )

    if (-not (Test-Path -LiteralPath $CsvPath -PathType Leaf)) {
        return @()
    }

    $rows = @(Import-Csv -LiteralPath $CsvPath)

    $trusted = @(
        $rows |
            Where-Object {
                $_.encoding -ne "utf8_bits" -and
                $_.event -notin @("other", "digit", "whitespace") -and
                $_.metric -ne "zeta_spectral_coherence"
            } |
            Sort-Object -Property @{
                Expression = {
                    try {
                        [math]::Abs([double]$_.z)
                    } catch {
                        0.0
                    }
                }
                Descending = $true
            }
    )

    return $trusted
}

function Export-TrustedSurvivors {
    param(
        [Parameter(Mandatory=$true)][object[]]$Rows,
        [Parameter(Mandatory=$true)][string]$OutCsv
    )

    $columns = @("language_guess", "encoding", "event", "metric", "z", "p_emp", "input")

    if ($Rows.Count -eq 0) {
        Set-Content -LiteralPath $OutCsv -Encoding UTF8 -Value (($columns -join ","))
        return
    }

    $Rows |
        Select-Object language_guess, encoding, event, metric, z, p_emp, input |
        Export-Csv -LiteralPath $OutCsv -NoTypeInformation -Encoding UTF8
}

function Export-InputSummary {
    param(
        [Parameter(Mandatory=$true)][object[]]$Rows,
        [Parameter(Mandatory=$true)][string]$OutCsv
    )

    if ($Rows.Count -eq 0) {
        Set-Content -LiteralPath $OutCsv -Encoding UTF8 -Value "input,trusted_survivor_count,strongest_abs_z,strongest_event,strongest_metric"
        return
    }

    $Rows |
        Group-Object input |
        ForEach-Object {
            $groupRows = @($_.Group)
            $strongest = $groupRows |
                Sort-Object -Property @{
                    Expression = {
                        try {
                            [math]::Abs([double]$_.z)
                        } catch {
                            0.0
                        }
                    }
                    Descending = $true
                } |
                Select-Object -First 1

            [pscustomobject]@{
                input = $_.Name
                trusted_survivor_count = $groupRows.Count
                strongest_abs_z = try { [math]::Abs([double]$strongest.z) } catch { 0.0 }
                strongest_event = $strongest.event
                strongest_metric = $strongest.metric
            }
        } |
        Sort-Object -Property trusted_survivor_count,strongest_abs_z -Descending |
        Export-Csv -LiteralPath $OutCsv -NoTypeInformation -Encoding UTF8
}

function Convert-RowsToMarkdown {
    param(
        [Parameter(Mandatory=$true)][object[]]$Rows,
        [Parameter(Mandatory=$true)][string[]]$Columns,
        [int]$MaxRows = 20
    )

    if ($Rows.Count -eq 0) {
        return "_No trusted survivors after filtering._"
    }

    $limited = @($Rows | Select-Object -First $MaxRows)

    $header = "| " + ($Columns -join " | ") + " |"
    $divider = "| " + (($Columns | ForEach-Object { "---" }) -join " | ") + " |"
    $lines = New-Object System.Collections.Generic.List[string]
    $lines.Add($header)
    $lines.Add($divider)

    foreach ($row in $limited) {
        $cells = foreach ($col in $Columns) {
            $value = [string]$row.$col
            $value = $value.Replace("|", "\|")
            if ($value.Length -gt 120) {
                $value = $value.Substring(0, 117) + "..."
            }
            $value
        }

        $lines.Add("| " + ($cells -join " | ") + " |")
    }

    return ($lines -join [Environment]::NewLine)
}

